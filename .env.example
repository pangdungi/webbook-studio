NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 관리자 출판 플랫폼 URL (편집·출판·링크 생성만 여기서)
NEXT_PUBLIC_SITE_URL=https://webbook-studio.vercel.app

# 독자에게 공유하는 링크 전용 URL (다른 도메인 권장 — 플랫폼과 완전 분리)
# 예: https://read.webbook-studio.vercel.app  비우면 SITE_URL과 동일
NEXT_PUBLIC_READER_URL=

# 독자 분석: 글검사와 동일 (SPELLCHECK_PROVIDER, ANTHROPIC_API_KEY)

# 맞춤법: 공개 검사기 사용. false 로 끔
SPELLCHECK_USE_PNU=true
# 시도 순서 (기본: 다음→네이버→부산대). PNU IP는 종종 타임아웃됨
# SPELLCHECK_SPELLER_ORDER=daum,naver,pnu
# 검사기 실패 시 AI 대체 (기본 true, ANTHROPIC_API_KEY 필요)
# SPELLCHECK_FALLBACK_AI=false
# SPELLCHECK_PNU_URL=http://164.125.7.61/speller/results
# 문법·문장 AI 보조(선택, 느림·JSON 오류 가능). 기본 false — PNU만 사용
# SPELLCHECK_AI_SUPPLEMENT=true
# Spellcheck AI 보조 시: openai | anthropic
SPELLCHECK_PROVIDER=anthropic
# 맞춤법·글검사·글평가 AI: sonnet 권장(정확). haiku는 빠르지만 검출 약함
SPELLCHECK_ANTHROPIC_MODEL=claude-sonnet-4-6
# 표준국어대사전 Open API(단어 검색, 문장 맞춤법 아님) — 추후 연동용
# STDICT_API_KEY=
# 글검사 OpenAI 사용 시 (선택)
WRITING_REVIEW_OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# PDF 출판 — 서버에 Chromium 필요 (로컬: npx playwright install chromium)
# Edge function / external store webhook (optional)
ISSUE_ACCESS_SECRET=
