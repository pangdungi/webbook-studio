NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 관리자 출판 플랫폼 URL (편집·출판·링크 생성만 여기서)
NEXT_PUBLIC_SITE_URL=https://webbook-studio.vercel.app

# 독자에게 공유하는 링크 전용 URL (다른 도메인 권장 — 플랫폼과 완전 분리)
# 예: https://read.webbook-studio.vercel.app  비우면 SITE_URL과 동일
NEXT_PUBLIC_READER_URL=

# 독자 분석: 글검사와 동일 (SPELLCHECK_PROVIDER, ANTHROPIC_API_KEY)

# Spellcheck: openai | anthropic | local
SPELLCHECK_PROVIDER=anthropic
SPELLCHECK_ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Edge function / external store webhook (optional)
ISSUE_ACCESS_SECRET=
